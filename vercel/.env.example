# Variables d'environnement des fonctions Vercel (Vercel > projet > Settings > Environment Variables).
# Copier ce fichier en .env pour tester en local avec `vercel dev` ; ne JAMAIS le versionner (.env est dans .gitignore).

# --- Google Drive (stockage des documents : storage.provider = "supabase+drive") ---------------------------------
# Google Cloud > APIs & Services > Credentials > OAuth client ID (type « Application Web »).
# URI de redirection autorisée : https://<votre-site>/api/drive-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtenu UNE fois : ouvrir https://<votre-site>/api/drive-auth, autoriser, copier le jeton affiché ici, redéployer.
GOOGLE_REFRESH_TOKEN=

# --- Supabase (vérification des comptes par les fonctions) --------------------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
# Clé publique « anon » (Supabase > Project Settings > API).
SUPABASE_ANON_KEY=

# --- Facultatif -------------------------------------------------------------------------------------------------------
# Nom du dossier racine dans Drive : « <nom> - Mes documents » (défaut : Win95).
WIN95_APP_NAME=Win95
# Table des comptes lue pour vérifier l'identité (défaut : win95_accounts, colonnes id et hash).
WIN95_ACCOUNTS_TABLE=win95_accounts
# Taille maximale d'un fichier envoyé dans Drive, en Mo (défaut : 50). À garder cohérent avec storage.drive.maxFileMb.
DRIVE_MAX_FILE_MB=50
